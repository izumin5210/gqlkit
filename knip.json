{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  },
  "tags": ["-lintignore"],
  "workspaces": {
    "packages/cli": {
      "entry": ["src/testing/bench/{main,compare,refs,run-case}.ts"],
      "ignoreFiles": ["src/**/testdata/**"],
      "ignoreDependencies": ["@gqlkit-ts/runtime"]
    }
  },
  "ignoreWorkspaces": ["examples/*", "packages/docs"],
  "ignoreDependencies": ["graphql", "tsx"]
}

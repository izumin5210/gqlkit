{
  "name": "@gqlkit-examples/with-prisma",
  "type": "module",
  "private": true,
  "scripts": {
    "gen": "node --import tsx ../../packages/cli/src/cli.ts gen",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "start": "node --import tsx src/server.ts",
    "dev": "pnpm prisma:generate && pnpm prisma:push && pnpm gen && pnpm start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gqlkit-ts/runtime": "workspace:*",
    "@graphql-tools/schema": "^10.0.0",
    "@prisma/adapter-better-sqlite3": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "better-sqlite3": "^11.0.0",
    "graphql": "catalog:",
    "graphql-scalars": "^1.24.0",
    "graphql-yoga": "^5.0.0"
  },
  "devDependencies": {
    "@gqlkit-ts/cli": "workspace:*",
    "@types/better-sqlite3": "^7.6.11",
    "prisma": "^7.2.0"
  }
}

{
  "extends": "../../tsconfig.base.json",
  "exclude": [
    "examples",
    "dist",
    "scripts",
    "src/**/testdata",
    "vitest.global-setup.ts"
  ],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "lib": ["es2024", "ESNext.Array", "ESNext.Collection", "ESNext.Iterator"],
    "types": ["node"],

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "jsx": "react-jsx"
  }
}
